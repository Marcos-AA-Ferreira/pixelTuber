/* =======================================================
   ESTILOS GLOBAIS (Base do Aplicativo)
======================================================= */
QWidget { 
    background-color: @BG_DARK; 
    color: @TEXT_PRIMARY; 
}
QScrollArea { border: none; background-color: transparent; }
QLineEdit { background: @BG_LIST; color: #00ff00; border: 1px solid #444; padding: 4px; border-radius: 3px; }
QSpinBox { background: @BG_LIST; color: white; border: 1px solid #444; padding: 2px; border-radius: 3px; }
QComboBox { background: @BG_LIST; color: white; border: 1px solid #444; border-radius: 3px; padding: 2px; }
QLabel { color: @TEXT_PRIMARY; background-color: transparent; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; }

QGroupBox { 
    font-weight: bold; border: 1px solid #333; 
    border-radius: 8px; margin-top: 15px; padding-top: 15px;
    color: @ACCENT;
}

/* --- Botões Genéricos --- */
QPushButton { 
    background-color: #2d2d2d; border: 1px solid #444; 
    padding: 8px; border-radius: @DEFAULT_ROUNDING; font-weight: bold; color: @TEXT_PRIMARY;
}
QPushButton:hover { background-color: @BG_HOVER; border-color: @ACCENT; }
QPushButton:checked { background-color: @SUCCESS; color: white; }

/* --- Identificadores de Botões Específicos (#) --- */
QPushButton#BtnPrimary { background-color: @SUCCESS; color: white; border: none; }
QPushButton#BtnPrimary:hover { background-color: @ACCENT; }

QPushButton#BtnDanger { background-color: @BG_CARD; color: @DANGER; border: 1px solid #444; }
QPushButton#BtnDanger:hover { background-color: @DANGER; color: white; }

QPushButton#BtnRemove { background-color: transparent; border: 1px solid #444; color: @DANGER; border-radius: 4px; font-size: 14px; }
QPushButton#BtnRemove:hover { background-color: @DANGER; color: white; border-color: @DANGER; }

QPushButton#BtnMute:checked { background-color: @DANGER; color: white; }

/* --- Componentes Especiais --- */
QFrame#AccessoryCard { background: @BG_CARD; border-radius: @CARD_ROUNDING; padding: 10px; border: 1px solid #333; }
QLabel#PreviewBox { background-color: @BG_PREVIEW; border: 2px solid #333; border-radius: @DEFAULT_ROUNDING; }
QLabel#TimeLabel { font-family: 'Consolas', monospace; font-size: 11px; color: @TEXT_MUTED; }
QLabel#MusicInfo { color: @ACCENT_GREEN; font-weight: bold; font-size: 12px; }

/* Sliders */
QSlider::groove:horizontal { background: #333; height: 6px; border-radius: 3px; }
QSlider::handle:horizontal { background: @ACCENT_GREEN; width: 14px; height: 14px; margin: -4px 0; border-radius: 7px; }
QSlider::sub-page:horizontal { background: @ACCENT_GREEN_DARK; border-radius: 3px; }


/* =======================================================
   ESTILOS DO EFFECT CREATOR (MODAL)
======================================================= */
#MainForm { background-color: #2b2b2b; }
#MainForm QLineEdit { padding: 10px; border-radius: 6px; background: #1a1a1a; color: white; border: 1px solid #444; font-family: 'Consolas'; font-size: 12px; }
#Title { color: @ACCENT; font-size: 15px; font-weight: bold; }
#SubLabel { color: #8b949e; font-size: 10px; font-weight: bold; text-transform: uppercase; }

#ModeBtn { background: #3d3d3d; border: 1px solid #555; padding: 5px; font-size: 10px; border-radius: 4px; color: white; }
#ModeBtn:checked { background: #1f6feb; border-color: @ACCENT; }

#StepBtn { background: #3d3d3d; color: white; border-radius: 15px; font-weight: bold; font-size: 16px; min-width: 30px; max-width: 30px; min-height: 30px; }
#StepBtn:hover { background: @ACCENT; }
#DurDisplay { background: #1a1a1a; color: @ACCENT; font-weight: bold; font-family: 'Consolas'; font-size: 14px; border: 1px solid #444; border-radius: 6px; padding: 5px 15px; }

#SaveBtn { background-color: #238636; color: white; font-weight: bold; font-size: 12px; border-radius: 6px; padding: 10px; }
#CancelBtn { background: transparent; color: @DANGER; font-weight: bold; border: 1px solid @DANGER; border-radius: 6px; padding: 10px; }
#CancelBtn:hover { background: @DANGER; color: white; }

/* Grupos de Áudio e Visual do Effect Creator */
#AudioGroup, #VisualGroup { background: #1e1e1e; border-radius: 10px; padding: 15px; border: 1px solid #333; }
#AudioGroup QLabel, #VisualGroup QLabel { color: #888; font-size: 11px; font-weight: bold; }
#BtnPreview:enabled { color: @ACCENT; border-color: #388bfd; }


/* =======================================================
   ESTILOS DA ABA DE EFEITOS (CARDS E TOAST)
======================================================= */
QFrame#EffectCardBase { background-color: #0d1117; border: 1px solid #30363d; border-radius: 8px; }
QFrame#EffectCardBase:hover { border: 1px solid @ACCENT; }
QFrame#EffectCardBase QPushButton { border: none; background: transparent; }
QFrame#EffectCardBase QPushButton:hover { background: #1f242b; border-radius: 4px; }

QPushButton#BtnNewEffect { background-color: #238636; color: white; font-weight: bold; font-size: 14px; padding: 15px; border-radius: 6px; border: none; }
QPushButton#BtnNewEffect:hover { background-color: #2ea043; }
QPushButton#BtnCaptureHotkey { background: #3d3d3d; color: white; border-radius: 6px; }
QLabel#LblHotkeyDisplay { color: #f1c40f; font-family: 'Consolas'; font-weight: bold; }

QFrame#MusicToastFrame { background-color: #1c1c1e; border-radius: 12px; border: 1px solid #333333; }